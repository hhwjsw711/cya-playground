# =============================================================================
# cya-playground 环境变量配置
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env.local（开发环境）或 .env.production（生产构建）
#   2. 将下列占位值替换为你自己的 Convex 部署信息
#
# 获取部署信息：
#   - 登录 https://dashboard.convex.dev 创建项目
#   - 项目首页可看到 CONVEX_DEPLOYMENT、CONVEX_URL、SITE URL
#   - 也可在项目根目录执行 `npx convex dev` 自动创建并写入 .env.local
#
# 安全提醒：
#   - .env.local 与 .env.production 已在 .gitignore 中，请勿提交
#   - 切勿将真实部署 URL 写入本文件（.env.example 会被提交到仓库）
# =============================================================================

# Convex 部署标识，`npx convex dev` 用于关联本地代码与云端部署
# 格式：dev:<deployment-name>（开发）/ <deployment-name>（生产）
CONVEX_DEPLOYMENT=dev:your-deployment-name

# 前端通过此 URL 连接 Convex 后端（WebSocket 实时订阅）
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# HTTP API 的基础 URL（REST 接口调用用，前缀为 /api/tasks）
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site
